# Empty for browser proxy. APK: reachable laptop LAN address or HTTPS origin, no /api/v1 suffix.
VITE_API_BASE_URL=
# Explicit development fixtures only. Never enable for live acceptance.
VITE_ENABLE_MOCKS=false
# Browser preview only: citizen to preview APK layouts; empty means responder website.
# Android automatically uses the citizen experience.
VITE_APP_MODE=
# Explicit inference budget: backend RELIEFMESH_AI_TIMEOUT_SECONDS + upload/HTTP margin.
# Default backend 90s + 30s margin. Changing this requires a new frontend build.
VITE_ANALYSIS_TIMEOUT_MS=120000

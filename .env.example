# Copy to .env in the backend checkout; never commit the populated file.
RELIEFMESH_AI_MODE=live
# ollama (local) or huggingface (online)
RELIEFMESH_AI_BACKEND=ollama
RELIEFMESH_MODEL_ID=gemma4:e2b
RELIEFMESH_OLLAMA_URL=http://127.0.0.1:11434
RELIEFMESH_HF_URL=https://router.huggingface.co/v1
# For Hugging Face, use an available multimodal Gemma provider model ID.
# RELIEFMESH_AI_BACKEND=huggingface
# RELIEFMESH_MODEL_ID=google/gemma-4-31B-it
HF_TOKEN=
RELIEFMESH_AI_TIMEOUT=90
RELIEFMESH_EMBEDDING_MODE=sentence_transformers
RELIEFMESH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# No surprise model downloads during requests. Prewarm intentionally or enable below.
RELIEFMESH_ALLOW_MODEL_DOWNLOAD=false
# Optional absolute paths; defaults are local database/reliefmesh.db and uploads/.
# RELIEFMESH_DB_PATH=
# RELIEFMESH_UPLOAD_DIR=
RELIEFMESH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost
